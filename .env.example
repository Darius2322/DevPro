# Copy to .env and fill in from your Supabase project settings (Settings > API).
# Only the anon/public key ever goes here. NEVER put the service-role key
# in this file or anywhere in the frontend — it belongs only in the
# secrets-vault Edge Function's environment (set via `supabase secrets set`).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
